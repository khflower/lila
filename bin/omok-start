#!/bin/sh -e

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROG=$(basename "$0")

usage() {
  printf '%s\n' "usage: $PROG <fullId> [renju|freestyle]" >&2
}

case "${1-}" in
  -h | --help | help)
    usage
    exit 0
    ;;
  *)
    [ $# -ge 1 ] && [ $# -le 2 ] || {
      usage
      exit 1
    }
    exec "$SCRIPT_DIR/omok-demo" start "$@"
    ;;
esac
