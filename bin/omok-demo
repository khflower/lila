#!/bin/sh -e

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROG=$(basename "$0")
DEFAULT_CLI_BIN="$SCRIPT_DIR/cli"
CLI_BIN=${LILA_OMOK_CLI_BIN:-"$DEFAULT_CLI_BIN"}
DOCTOR_FAILED=0
DOCTOR_REPORT=

usage() {
  printf '%s\n' "usage: $PROG <seed|start|show|clear> <id> [renju|freestyle] [move ...]" >&2
  printf '%s\n' "       $PROG doctor" >&2
}

ensure_cli_bin() {
  [ -x "$CLI_BIN" ] && return 0
  printf '%s\n' "omok-demo: CLI helper is missing or not executable: $CLI_BIN" >&2
  printf '%s\n' "Set LILA_OMOK_CLI_BIN to a working bin/cli-style helper or restore $DEFAULT_CLI_BIN." >&2
  exit 1
}

doctor_line() {
  LINE="$1 $2"
  if [ -n "$DOCTOR_REPORT" ]; then
    DOCTOR_REPORT="$DOCTOR_REPORT
$LINE"
  else
    DOCTOR_REPORT=$LINE
  fi
}

doctor_pass() { doctor_line "PASS" "$1"; }
doctor_fail() { DOCTOR_FAILED=1; doctor_line "FAIL" "$1"; }
doctor_info() { doctor_line "INFO" "$1"; }

is_wordish_id() {
  case "$1" in
    '') return 1 ;;
    *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_-]*) return 1 ;;
    *) return 0 ;;
  esac
}

ensure_full_id() {
  FULL_ID=$1
  if [ ${#FULL_ID} -eq 12 ] && is_wordish_id "$FULL_ID"; then
    return 0
  fi
  printf '%s\n' "omok-demo: invalid fullId '$FULL_ID'; expected 12 characters matching [A-Za-z0-9_-]" >&2
  printf '%s\n' "The matching gameId is the first 8 characters of the fullId." >&2
  exit 1
}

doctor_compact_output() {
  VALUE=$(printf '%s' "$1" | tr '\r\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//')
  if [ -n "$VALUE" ]; then
    printf '%s\n' "$VALUE"
  else
    printf '%s\n' "<empty>"
  fi
}

doctor_default_cli_runtime() {
  if command -v curl >/dev/null 2>&1; then
    doctor_pass "curl is available in PATH"
  else
    doctor_fail "curl is not available in PATH"
    return
  fi

  if [ -n "${LILA_CLI_TOKEN_DEV-}" ]; then
    doctor_pass "LILA_CLI_TOKEN_DEV is set"
  else
    doctor_fail "LILA_CLI_TOKEN_DEV is not set"
  fi

  if HTTP_CODE=$(
    curl -sS -o /dev/null -w '%{http_code}' \
      --connect-timeout 2 \
      --max-time 2 \
      -X POST \
      -d '' \
      http://localhost:9663/run/cli \
      2>/dev/null
  ); then
    if [ "$HTTP_CODE" = "000" ]; then
      doctor_fail "http://localhost:9663/run/cli did not return an HTTP response"
    else
      doctor_pass "http://localhost:9663/run/cli responded with HTTP $HTTP_CODE"
    fi
  else
    CURL_STATUS=$?
    doctor_fail "http://localhost:9663/run/cli is unreachable (curl exit $CURL_STATUS)"
  fi
}

doctor_cli_probe() {
  set +e
  CLI_OUTPUT=$("$CLI_BIN" uptime 2>&1)
  CLI_STATUS=$?
  set -e

  CLI_OUTPUT=$(doctor_compact_output "$CLI_OUTPUT")
  if [ "$CLI_STATUS" -ne 0 ]; then
    doctor_fail "CLI helper could not run 'uptime' (exit $CLI_STATUS): $CLI_OUTPUT"
    return
  fi

  case "$CLI_OUTPUT" in
    *seconds)
      doctor_pass "CLI helper completed 'uptime': $CLI_OUTPUT"
      ;;
    *)
      doctor_fail "CLI helper returned unexpected output for 'uptime': $CLI_OUTPUT"
      ;;
  esac
}

doctor() {
  DOCTOR_FAILED=0
  DOCTOR_REPORT=
  doctor_info "helper path: $CLI_BIN"
  if [ -x "$CLI_BIN" ]; then
    doctor_pass "CLI helper is executable"
  else
    doctor_fail "CLI helper is missing or not executable: $CLI_BIN"
  fi

  if [ "$CLI_BIN" = "$DEFAULT_CLI_BIN" ]; then
    doctor_default_cli_runtime
  else
    doctor_info "skipped local LILA_CLI_TOKEN_DEV and localhost:9663/run/cli checks because LILA_OMOK_CLI_BIN overrides the default bin/cli helper"
  fi

  if [ -x "$CLI_BIN" ]; then
    doctor_cli_probe
  fi

  if [ "$DOCTOR_FAILED" -eq 0 ]; then
    printf '%s\n' "omok-demo doctor: PASS"
    doctor_info "ready: bin/omok-start <fullId> [renju|freestyle]"
  else
    printf '%s\n' "omok-demo doctor: FAIL"
    doctor_info "fix the failing helper/runtime checks before the live demo"
  fi
  printf '%s\n' "$DOCTOR_REPORT"
  [ "$DOCTOR_FAILED" -eq 0 ]
}

case "${1-}" in
  seed)
    [ $# -ge 2 ] || { usage; exit 1; }
    ensure_cli_bin
    exec "$CLI_BIN" omok "$@"
    ;;
  start)
    [ $# -ge 2 ] && [ $# -le 3 ] || { usage; exit 1; }
    ensure_full_id "$2"
    ensure_cli_bin
    exec "$CLI_BIN" omok "$@"
    ;;
  show | clear)
    [ $# -eq 2 ] || { usage; exit 1; }
    ensure_cli_bin
    exec "$CLI_BIN" omok "$@"
    ;;
  doctor)
    [ $# -eq 1 ] || { usage; exit 1; }
    doctor
    ;;
  -h | --help | help)
    usage
    exit 0
    ;;
  *)
    usage
    exit 1
    ;;
esac
