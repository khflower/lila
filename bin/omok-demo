#!/bin/sh -e

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CLI_BIN=${LILA_OMOK_CLI_BIN:-"$SCRIPT_DIR/cli"}

usage() {
  echo "usage: $(basename "$0") <seed|show|clear> <gameId> [renju|freestyle] [move ...]" >&2
}

ensure_cli_bin() {
  [ -x "$CLI_BIN" ] && return 0
  printf '%s\n' "omok-demo: CLI helper is missing or not executable: $CLI_BIN" >&2
  printf '%s\n' "Set LILA_OMOK_CLI_BIN to a working bin/cli-style helper or restore $SCRIPT_DIR/cli." >&2
  exit 1
}

case "${1-}" in
  seed)
    [ $# -ge 2 ] || {
      usage
      exit 1
    }
    ;;
  show | clear)
    [ $# -eq 2 ] || {
      usage
      exit 1
    }
    ;;
  -h | --help | help)
    usage
    exit 0
    ;;
  *)
    usage
    exit 1
    ;;
esac

ensure_cli_bin
exec "$CLI_BIN" omok "$@"
