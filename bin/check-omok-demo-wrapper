#!/bin/sh -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
WRAPPER="$ROOT/bin/omok-demo"
TMPDIR=$(mktemp -d "${TMPDIR:-/tmp}/omok-demo-wrapper.XXXXXX")
STUB="$TMPDIR/cli-stub"
STUB_LOG="$TMPDIR/cli.log"

cleanup() {
  rm -rf "$TMPDIR"
}

trap cleanup EXIT INT TERM HUP

cat >"$STUB" <<'EOF'
#!/bin/sh -eu
printf '%s\n' "$*" >"$OMOK_DEMO_STUB_LOG"
EOF

chmod +x "$STUB"

assert_eq() {
  if [ "$1" != "$2" ]; then
    printf 'expected: %s\nactual:   %s\n' "$1" "$2" >&2
    exit 1
  fi
}

assert_usage() {
  assert_eq "$1" "usage: omok-demo <seed|start|show|clear> <id> [renju|freestyle] [move ...]
       omok-demo doctor"
}

assert_not_called() {
  if [ -f "$STUB_LOG" ]; then
    printf 'wrapper unexpectedly reached stub CLI: %s\n' "$(cat "$STUB_LOG")" >&2
    exit 1
  fi
}

run_wrapper_with_cli() {
  CLI_BIN=$1
  shift
  rm -f "$STUB_LOG"
  set +e
  OUTPUT=$(
    LILA_OMOK_CLI_BIN="$CLI_BIN" \
      OMOK_DEMO_STUB_LOG="$STUB_LOG" \
      "$WRAPPER" "$@" 2>&1
  )
  STATUS=$?
  set -e
}

run_wrapper() {
  run_wrapper_with_cli "$STUB" "$@"
}

run_wrapper --help
assert_eq "$STATUS" "0"
assert_usage "$OUTPUT"
assert_not_called

run_wrapper
assert_eq "$STATUS" "1"
assert_usage "$OUTPUT"
assert_not_called

run_wrapper seed demo1234 renju H8 A1
assert_eq "$STATUS" "0"
assert_eq "$OUTPUT" ""
assert_eq "$(cat "$STUB_LOG")" "omok seed demo1234 renju H8 A1"

run_wrapper start demo1234abcd
assert_eq "$STATUS" "0"
assert_eq "$OUTPUT" ""
assert_eq "$(cat "$STUB_LOG")" "omok start demo1234abcd"

run_wrapper start demo1234abcd freestyle
assert_eq "$STATUS" "0"
assert_eq "$OUTPUT" ""
assert_eq "$(cat "$STUB_LOG")" "omok start demo1234abcd freestyle"

run_wrapper doctor
assert_eq "$STATUS" "0"
assert_eq "$OUTPUT" "omok-demo doctor: PASS
INFO helper path: $STUB
PASS CLI helper is executable
INFO skipped local LILA_CLI_TOKEN_DEV and localhost:9663/run/cli checks because LILA_OMOK_CLI_BIN overrides the default bin/cli helper"
assert_not_called

run_wrapper show demo1234
assert_eq "$STATUS" "0"
assert_eq "$OUTPUT" ""
assert_eq "$(cat "$STUB_LOG")" "omok show demo1234"

run_wrapper clear demo1234
assert_eq "$STATUS" "0"
assert_eq "$OUTPUT" ""
assert_eq "$(cat "$STUB_LOG")" "omok clear demo1234"

MISSING_CLI="$TMPDIR/missing-cli"
run_wrapper_with_cli "$MISSING_CLI" show demo1234
assert_eq "$STATUS" "1"
assert_eq "$OUTPUT" "omok-demo: CLI helper is missing or not executable: $MISSING_CLI
Set LILA_OMOK_CLI_BIN to a working bin/cli-style helper or restore $ROOT/bin/cli."
assert_not_called

run_wrapper_with_cli "$MISSING_CLI" doctor
assert_eq "$STATUS" "1"
assert_eq "$OUTPUT" "omok-demo doctor: FAIL
INFO helper path: $MISSING_CLI
FAIL CLI helper is missing or not executable: $MISSING_CLI
INFO skipped local LILA_CLI_TOKEN_DEV and localhost:9663/run/cli checks because LILA_OMOK_CLI_BIN overrides the default bin/cli helper"
assert_not_called

run_wrapper seed
assert_eq "$STATUS" "1"
assert_usage "$OUTPUT"
assert_not_called

run_wrapper start
assert_eq "$STATUS" "1"
assert_usage "$OUTPUT"
assert_not_called

printf 'omok-demo wrapper smoke check passed\n'
